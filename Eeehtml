.grid{grid-template-columns:minmax(0,1.18fr) minmax(0,.82fr);gap:15px}
.panel{position:relative;overflow:hidden;background:linear-gradient(145deg,rgba(15,20,28,.96),rgba(7,10,15,.97));border:1px solid rgba(255,255,255,.075);border-radius:22px;padding:16px;gap:12px;box-shadow:0 24px 70px rgba(0,0,0,.32),inset 0 1px rgba(255,255,255,.045)}
.panel:before{content:"";position:absolute;left:18px;right:18px;top:0;height:1px;background:linear-gradient(90deg,transparent,var(--accent),var(--accent-2),transparent);opacity:.75}
.panel-head label{font-size:.72rem;color:#cbd4df;letter-spacing:.12em}.stat{font-size:.66rem}
textarea{min-height:330px;background:radial-gradient(circle at 100% 0,rgba(124,92,255,.06),transparent 40%),#06090e;color:#dfe7f0;border:1px solid #1d2733;border-radius:15px;padding:14px;font-size:.78rem;line-height:1.6;box-shadow:inset 0 0 35px rgba(0,0,0,.28);transition:.2s}textarea:focus{border-color:rgba(124,92,255,.75);box-shadow:0 0 0 3px rgba(124,92,255,.09),inset 0 0 35px rgba(0,0,0,.3)}
.opt{padding:7px 9px;border:1px solid #18212c;background:#090d13;border-radius:10px;font-size:.68rem}select,input[type=text],input[type=password]{background:#080c12;border:1px solid #202a36;border-radius:8px;padding:6px 8px;font-size:.7rem}
button{font-size:.76rem;border-radius:11px;border:1px solid #273241;padding:10px 15px;background:#0b1017;transition:.18s}.btn-primary{border:0;color:#fff;background:linear-gradient(135deg,var(--accent),#5f7cff 55%,var(--accent-2));box-shadow:0 10px 28px rgba(90,91,255,.25)}.btn-primary:hover{filter:brightness(1.12);box-shadow:0 12px 34px rgba(90,91,255,.36);transform:translateY(-1px)}.btn-ghost:hover{background:#111824;border-color:#3a4657}
.toast{background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 12px 35px rgba(0,0,0,.4)}
#authGate{background:radial-gradient(700px 500px at 50% 30%,rgba(124,92,255,.14),transparent 65%),#030406}.authBox{max-width:390px;padding:25px;border-radius:25px;background:linear-gradient(145deg,#111722,#080b10);border:1px solid rgba(255,255,255,.09);box-shadow:0 35px 100px rgba(0,0,0,.55),0 0 70px rgba(124,92,255,.09)}.authBox input{padding:11px 12px}
@media(max-width:820px){.grid{grid-template-columns:1fr}textarea{min-height:260px}}
@media(max-width:520px){body{padding-top:8px}.wrap{padding:0 10px 40px}.topbar{padding:13px;border-radius:19px}.brand h1{font-size:1rem}.tagline{font-size:.67rem}.panel{padding:12px;border-radius:18px}.opt{flex:1 1 auto}textarea{font-size:.72rem}}

</style>

<script>
(function(){
"use strict";
const $ = id => document.getElementById(id);

/* ============ AUTH GATE (local, per-browser) ============
   Không có backend thật ở đây — tài khoản lưu trong localStorage
   của trình duyệt này (đã hash SHA-256, không lưu plaintext).
   Đây là khoá truy cập cục bộ, KHÔNG phải hệ thống đăng nhập
   nhiều thiết bị / bảo mật server-side thật. */
const AUTHKEY='__loA3';
async function sha256(str){
  const buf=await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
function loadUsers(){ try{return JSON.parse(localStorage.getItem(AUTHKEY)||'{}');}catch(e){return {};} }
function saveUsers(u){ localStorage.setItem(AUTHKEY, JSON.stringify(u)); }
let authMode='login';
const gate=$('authGate'), wrapEl=$('wrap');
function setAuthErr(t){ $('authErr').textContent=t||''; }
function paintAuthMode(){
  const d=DICT[lang];
  $('authTitle').textContent = authMode==='login'? d.authLogin : d.authRegister;
  $('authSub').textContent = d.authSub;
  $('authGo').textContent = authMode==='login'? d.authGoLogin : d.authGoRegister;
  $('authSwitch').textContent = authMode==='login'? d.authSwitchToReg : d.authSwitchToLogin;
}
$('authSwitch').addEventListener('click', ()=>{ authMode = authMode==='login'?'register':'login'; setAuthErr(''); paintAuthMode(); });
$('authGo').addEventListener('click', async ()=>{
  const u=$('authUser').value.trim(), p=$('authPass').value;
  const d=DICT[lang];
  if(!u||!p){ setAuthErr(d.authErrEmpty); return; }
  const users=loadUsers();
  if(authMode==='register'){
    if(users[u]){ setAuthErr(d.authErrExists); return; }
    users[u]={hash: await sha256(p), created: Date.now()};
    saveUsers(users);
    sessionOpen(u);
  }else{
    const rec=users[u];
    if(!rec || rec.hash !== await sha256(p)){ setAuthErr(d.authErrBad); return; }
    sessionOpen(u);
  }
});
function sessionOpen(u){
  sessionStorage.setItem('__loA3sess', u);
  gate.classList.add('hidden');
  wrapEl.classList.remove('locked');
  $('whoBtn').textContent = u;
}
function sessionCheck(){
  const u=sessionStorage.getItem('__loA3sess');
  const users=loadUsers();
  if(u && users[u]){ gate.classList.add('hidden'); wrapEl.classList.remove('locked'); $('whoBtn').textContent=u; }
}
$('whoBtn').addEventListener('click', ()=>{
  sessionStorage.removeItem('__loA3sess');
  gate.classList.remove('hidden');
  wrapEl.classList.add('locked');
  $('authUser').value=''; $('authPass').value=''; setAuthErr('');
});

/* ---------- theme color ---------- */
function hexToRgb(hex){ const m=hex.replace('#',''); return [0,2,4].map(i=>parseInt(m.substr(i,2),16)); }
function setAccent(hex){
  document.documentElement.style.setProperty('--accent', hex);
  const [r,g,b]=hexToRgb(hex);
  document.documentElement.style.setProperty('--accent-dim', `rgba(${r},${g},${b},0.18)`);
}
$('accentPicker').addEventListener('input', e=> setAccent(e.target.value));

/* ---------- language ---------- */
const DICT = {
  vi:{
    tagline:"Obfuscate = mã hoá code Lua thành dạng khó đọc, kèm loader tự giải mã lúc chạy — engine v3: nhiều lớp XOR+rotate+S-box, VM dispatch loader, chống decompile tốt hơn và không lag với script lớn.",
    lblInput:"Input — Lua gốc", lblOutput:"Output — đã obfuscate",
    fileLabel:"Tải file .lua ", runBtn:"Obfuscate", copyBtn:"Copy", dlBtn:"Tải file .lua",
    l1:"Số lớp", l2:"Độ dài khoá", l3:"Junk code", l4:"Bit-rotation", l5:"Chia khối", l6:"Checksum", l7:"S-box",
    l3a:"Tắt", l3b:"Bật", l4a:"Tắt", l4b:"Bật", l6a:"Tắt", l6b:"Bật", l7a:"Tắt", l7b:"Bật",
    toast:"Đã copy", placeholderSrc:"-- dán script Lua của bạn vào đây\nprint('hello world')",
    placeholderOut:"Kết quả sẽ hiện ở đây...", charUnit:"ký tự",
    authLogin:"Đăng nhập", authRegister:"Tạo tài khoản", authSub:"Cần tài khoản để dùng công cụ. Dữ liệu lưu cục bộ trên trình duyệt này.",
    authGoLogin:"Đăng nhập", authGoRegister:"Tạo tài khoản",
    authSwitchToReg:"Tạo tài khoản", authSwitchToLogin:"Đã có tài khoản? Đăng nhập",
    authErrEmpty:"Nhập đủ tên đăng nhập và mật khẩu", authErrExists:"Tên đăng nhập đã tồn tại", authErrBad:"Sai tên đăng nhập hoặc mật khẩu"
  },
  en:{
    tagline:"Obfuscate = turns Lua code into hard-to-read form with a self-decoding loader — engine v3: multi-layer XOR+rotate+S-box, VM-dispatch loader, harder to decompile and no lag on large scripts.",
    lblInput:"Input — Original Lua", lblOutput:"Output — Obfuscated",
    fileLabel:"Upload .lua ", runBtn:"Obfuscate", copyBtn:"Copy", dlBtn:"Download .lua",
    l1:"Layers", l2:"Key length", l3:"Junk code", l4:"Bit-rotation", l5:"Chunks", l6:"Checksum", l7:"S-box",
    l3a:"Off", l3b:"On", l4a:"Off", l4b:"On", l6a:"Off", l6b:"On", l7a:"Off", l7b:"On",
    toast:"Copied", placeholderSrc:"-- paste your Lua script here\nprint('hello world')",
    placeholderOut:"Result will appear here...", charUnit:"chars",
    authLogin:"Log in", authRegister:"Create account", authSub:"An account is required. Data is stored locally in this browser only.",
    authGoLogin:"Log in", authGoRegister:"Create account",
    authSwitchToReg:"Create account", authSwitchToLogin:"Have an account? Log in",
    authErrEmpty:"Enter a username and password", authErrExists:"Username already taken", authErrBad:"Wrong username or password"
  }
};
let lang='vi';
function applyLang(){
  const d=DICT[lang];
  $('tagline').textContent=d.tagline; $('lblInput').textContent=d.lblInput; $('lblOutput').textContent=d.lblOutput;
  $('runBtn').textContent=d.runBtn; $('copyBtn').textContent=d.copyBtn; $('dlBtn').textContent=d.dlBtn;
  $('l1').textContent=d.l1; $('l2').textContent=d.l2; $('l3').textContent=d.l3; $('l4').textContent=d.l4;
  $('l5').textContent=d.l5; $('l6').textContent=d.l6; $('l7').textContent=d.l7;
  $('l3a').textContent=d.l3a; $('l3b').textContent=d.l3b; $('l4a').textContent=d.l4a; $('l4b').textContent=d.l4b;
  $('l6a').textContent=d.l6a; $('l6b').textContent=d.l6b; $('l7a').textContent=d.l7a; $('l7b').textContent=d.l7b;
  srcEl.placeholder=d.placeholderSrc; outEl.placeholder=d.placeholderOut;
  document.getElementById('htmlRoot').lang=lang;
  $('fileIn').parentElement.childNodes[0].nodeValue=d.fileLabel;
  paintAuthMode();
}
$('langBtn').addEventListener('click', ()=>{ lang = lang==='vi'?'en':'vi'; applyLang(); });

const srcEl=$('src'), outEl=$('out'), inStat=$('inStat'), outStat=$('outStat'), timeStat=$('timeStat');

/* ============ ENGINE v3 ============
   Kiến trúc mới so với v2:
   - Xử lý bytes bằng Uint8Array thay vì mảng JS thường (nhanh hơn nhiều với file lớn)
   - Sửa lỗi lag chính của v2: loop giải mã cũ dò qua TẤT CẢ các chunk ở
     mỗi byte (chi phí O(n*chunks)). v3 tính thẳng chỉ số bảng con bằng
     modulo/floor — không còn chuỗi "or" tuần tự => O(n) thật sự.
   - Thêm lớp S-box (bảng thế byte) cố định theo seed mỗi lần chạy, xen
     giữa các lớp XOR+rotate => phân tích tần suất byte khó hơn nhiều.
   - Loader dùng mô hình "VM dispatch nhỏ": các lớp giải mã được duyệt
     qua một bảng lệnh (opcode table) thay vì viết thẳng tuần tự, để
     việc đọc code sinh ra ít gợi ý cấu trúc rõ ràng hơn.
   - Tên biến/hàm sinh ngẫu nhiên lại mỗi lần chạy + nhiễu (junk) rải
     ngẫu nhiên hơn v2 (không chỉ ở đầu/cuối khối).
*/
function rB(){ return (Math.random()*255|0)+1; }
function rName(len){
  const c='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ', d='0123456789';
  let s='_'+c[Math.random()*c.length|0];
  for(let i=1;i<len;i++) s += (Math.random()<0.7?c:d)[Math.random()*(Math.random()<0.7?c.length:d.length)|0];
  return s;
}
function toBytes(str){ return new Uint8Array(new TextEncoder().encode(str)); }
function junkLine(){
  const a=rName(6), n1=rB(), n2=rB();
  const forms=[
    `local ${a}=(${n1}*${n2})%256`,
    `local ${a}={${n1},${n2},${(n1+n2)%256}}`,
    `local ${a}=(function() return ${n1} end)()`,
    `if (${n1}+${n2})%2==2 then local ${a}=${n1} end`,
    `local ${a}=${n1}~=${n2} and ${n1} or ${n2}`
  ];
  return forms[Math.random()*forms.length|0];
}
function rol8(b,r){ return r===0? b : ((b<<r)|(b>>>(8-r)))&0xFF; }
function buildSbox(seed){
  const box=Array.from({length:256},(_,i)=>i);
  let s=seed;
  const rnd=()=>{ s=(s*1103515245+12345)&0x7fffffff; return s/0x7fffffff; };
  for(let i=255;i>0;i--){ const j=(rnd()*(i+1))|0; [box[i],box[j]]=[box[j],box[i]]; }
  const inv=new Array(256);
  box.forEach((v,i)=>inv[v]=i);
  return {box, inv};
}

function obfuscate(source, layers, keylen, junkOn, rotOn, chunkCount, checksumOn, sboxOn){
  let bytes = toBytes(source);
  const keys=[], rots=[];
  const seed = rB()*1000+rB();
  const {box, inv} = buildSbox(seed);
  for(let l=0;l<layers;l++){
    const key=Array.from({length:keylen}, rB);
    keys.push(key);
    const rot = rotOn ? (1+(Math.random()*7|0)) : 0;
    rots.push(rot);
    const nb=new Uint8Array(bytes.length);
    for(let i=0;i<bytes.length;i++){
      let v = rol8(bytes[i], rot) ^ key[i % key.length];
      if(sboxOn) v = box[v];
      nb[i]=v;
    }
    bytes=nb;
  }
  let checksum=0; for(let i=0;i<bytes.length;i++) checksum=(checksum+bytes[i])%256;

  chunkCount=Math.max(1, chunkCount|0);
  const chunkArrs=Array.from({length:chunkCount},()=>[]);
  for(let i=0;i<bytes.length;i++) chunkArrs[i%chunkCount].push(bytes[i]);

  const N={
    K:rName(8)+'s', O:rName(8), bxorFn:rName(7), rorFn:rName(7),
    iVar:rName(4), cVar:rName(4), lyr:rName(4), sumVar:rName(6),
    tmp:rName(5), sboxVar:rName(6), chTbl:rName(6), opFn:rName(6)
  };
  const chunkNames=chunkArrs.map(()=>rName(6));
  const keysLua=keys.map(k=>'{'+k.join(',')+'}').join(',');
  function jb(n){ let s=''; for(let i=0;i<n;i++) s+=junkLine()+'\n'; return s.trim(); }
  const rndJunk = ()=> junkOn && Math.random()<0.5 ? junkLine()+'\n' : '';

  const L=[];
  L.push(`local ${N.bxorFn}=bit32 and bit32.bxor or function(a,b) local r,p=0,1 while a>0 or b>0 do local x,y=a%2,b%2 if x~=y then r=r+p end a,b,p=(a-x)/2,(b-y)/2,p*2 end return r end`);
  L.push(`local function ${N.rorFn}(v,r) if r==0 then return v end local lo=v%(2^r) local hi=math.floor(v/(2^r)) return (hi+lo*(2^(8-r)))%256 end`);
  if(junkOn) L.push(jb(1+(Math.random()*2|0)));
  if(sboxOn) L.push(`local ${N.sboxVar}={${inv.join(',')}}`);
  // store chunks as a single table-of-tables so the decode loop can
  // index directly (O(1) per byte) instead of scanning every chunk.
  L.push(`local ${N.chTbl}={${chunkArrs.map((arr,i)=>`{${arr.join(',')}}`).join(',')}}`);
  L.push(rndJunk());
  L.push(`local ${N.O}={}`);
  L.push(`local ${N.cVar}=0`);
  L.push(`for ${N.iVar}=0,${bytes.length-1} do`);
  L.push(`  ${N.cVar}=${N.cVar}+1`);
  L.push(`  local __ci=(${N.iVar}%${chunkCount})+1`);
  L.push(`  local __co=math.floor(${N.iVar}/${chunkCount})+1`);
  L.push(`  local __v=${N.chTbl}[__ci][__co]`);
  if(sboxOn) L.push(`  __v=${N.sboxVar}[__v+1]`);
  L.push(`  ${N.O}[${N.cVar}]=__v`);
  L.push(`end`);
  L.push(rndJunk());
  if(checksumOn){
    L.push(`local ${N.sumVar}=0`);
    L.push(`for ${N.iVar}=1,#${N.O} do ${N.sumVar}=(${N.sumVar}+${N.O}[${N.iVar}])%256 end`);
    L.push(`if ${N.sumVar}~=${checksum} then return end`);
  }
  L.push(`local ${N.K}={${keysLua}}`);
  L.push(`local ${N.lyr}={${rots.join(',')}}`);
  if(junkOn) L.push(junkLine());
  // opcode-table "VM" for the reverse layer pass: a small dispatch
  // table drives the unrotate/unxor step instead of an inline literal
  // sequence, so static readers see indirection rather than a plain loop.
  L.push(`local ${N.opFn}={`);
  L.push(`  [1]=function(v,k,r) return ${N.rorFn}(v,r) end,`);
  L.push(`  [2]=function(v,k,r) return ${N.bxorFn}(v,k) end`);
  L.push(`}`);
  L.push(`for __l=#${N.K},1,-1 do`);
  L.push(`  local k=${N.K}[__l]`);
  L.push(`  local r=${N.lyr}[__l]`);
  L.push(`  for ${N.iVar}=1,#${N.O} do`);
  L.push(`    local v=${N.O}[${N.iVar}]`);
  L.push(`    v=${N.opFn}[2](v, k[((${N.iVar}-1)%#k)+1], r)`);
  L.push(`    v=${N.opFn}[1](v, k[((${N.iVar}-1)%#k)+1], r)`);
  L.push(`    ${N.O}[${N.iVar}]=v`);
  L.push(`  end`);
  L.push(`end`);
  L.push(rndJunk());
  L.push(`local ${N.tmp}={}`);
  L.push(`for ${N.iVar}=1,#${N.O} do ${N.tmp}[${N.iVar}]=string.char(${N.O}[${N.iVar}]) end`);
  if(junkOn) L.push(junkLine());
  L.push(`local ok,exec=pcall(function() return (loadstring or load)(table.concat(${N.tmp})) end)`);
  L.push(`if ok and exec then return exec() end`);
  return L.join('\n')+'\n';
}

function updateInStat(){
  const n=srcEl.value.length;
  inStat.textContent = n? `${n} ${DICT[lang].charUnit}` : '';
}
srcEl.addEventListener('input', updateInStat);

$('fileIn').addEventListener('change', e=>{
  const f=e.target.files[0]; if(!f) return;
  const r=new FileReader();
  r.onload=()=>{ srcEl.value=r.result; updateInStat(); };
  r.readAsText(f);
});

$('runBtn').addEventListener('click', ()=>{
  const src=srcEl.value;
  if(!src.trim()){ outEl.value=''; outStat.textContent=''; timeStat.textContent=''; return; }
  const layers=parseInt($('layers').value,10);
  const keylen=parseInt($('keylen').value,10);
  const junkOn=$('junk').value==='1';
  const rotOn=$('rot').value==='1';
  const chunkCount=parseInt($('chunks').value,10);
  const checksumOn=$('checksum').value==='1';
  const sboxOn=$('sbox').value==='1';
  const t0=performance.now();
  try{
    const result=obfuscate(src, layers, keylen, junkOn, rotOn, chunkCount, checksumOn, sboxOn);
    const dt=(performance.now()-t0).toFixed(1);
    outEl.value=result;
    outStat.textContent=`${result.length} ${DICT[lang].charUnit} · ${layers}L · ${chunkCount}c${rotOn?' · rot':''}${checksumOn?' · chk':''}${sboxOn?' · sbox':''}`;
    timeStat.textContent=`${dt}ms`;
  }catch(err){
    outEl.value='-- error: '+err.message;
    timeStat.textContent='';
  }
});

$('copyBtn').addEventListener('click', async ()=>{
  if(!outEl.value) return;
  try{ await navigator.clipboard.writeText(outEl.value); }
  catch(e){ outEl.select(); document.execCommand('copy'); }
  const t=$('toast'); t.textContent=DICT[lang].toast; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 1200);
});

$('dlBtn').addEventListener('click', ()=>{
  if(!outEl.value) return;
  const blob=new Blob([outEl.value], {type:'text/plain'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a'); a.href=url; a.download='obfuscated.lua';
  document.body.appendChild(a); a.click(); a.remove();
  URL.revokeObjectURL(url);
});

applyLang();
sessionCheck();
})();
</script>

<!DOCTYPE html>
<html lang="vi" id="htmlRoot">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lua Obfuscator v3</title>
<style>
:root{
  --bg:#0a0f0d; --bg2:#111a16; --panel:#141f1a; --panel2:#0f1815;
  --line:#233129; --text:#e4f2e9; --muted:#8aa397;
  --accent:#5ee6a8; --accent-2:#3fb8c9; --accent-dim:#1d3b30; --warn:#e6b85e;
  --radius:14px;
  --mono:'JetBrains Mono','Fira Code',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
:root:not([data-theme="light"]){}
:root[data-theme="light"]{
  --bg:#f3f6f4; --bg2:#e9efec; --panel:#ffffff; --panel2:#f7faf8;
  --line:#d6e0da; --text:#132019; --muted:#5f7269;
  --accent-dim:#d8f3e6; --warn:#8a6412;
}
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){
    --bg:#f3f6f4; --bg2:#e9efec; --panel:#ffffff; --panel2:#f7faf8;
    --line:#d6e0da; --text:#132019; --muted:#5f7269;
    --accent-dim:#d8f3e6; --warn:#8a6412;
  }
}
*{box-sizing:border-box;}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%;}
body{
  margin:0; background:
    radial-gradient(1200px 600px at 10% -10%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%),
    radial-gradient(900px 500px at 100% 0%, color-mix(in srgb, var(--accent-2) 10%, transparent), transparent 60%),
    var(--bg);
  color:var(--text);
  font-family:var(--mono);
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  min-height:100%;
}
.wrap{max-width:960px;margin:0 auto;padding:20px 16px 60px;}
.topbar{display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:18px; flex-wrap:wrap;}
.brand{display:flex;align-items:center;gap:10px;}
.brand .dot{width:10px;height:10px;border-radius:50%;background:var(--accent); box-shadow:0 0 12px var(--accent);}
.brand h1{font-size:1.15rem;margin:0;font-weight:800;letter-spacing:.2px;}
.brand .owner{font-size:.68rem;color:var(--muted);}
.tools{display:flex;align-items:center;gap:8px;}
.icon-btn{width:36px;height:36px;border-radius:9px;border:1px solid var(--line);background:var(--panel); display:flex;align-items:center;justify-content:center;cursor:pointer; text-decoration:none; color:var(--text);}
.icon-btn:hover{border-color:var(--accent);}
.icon-btn svg{width:18px;height:18px;}
input[type=color]{width:36px;height:36px;border:1px solid var(--line);border-radius:9px;padding:2px;background:var(--panel);cursor:pointer;}
.lang-btn,.user-btn{font-family:var(--mono);font-size:.72rem;font-weight:700;border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:9px;padding:8px 10px;cursor:pointer;}
.lang-btn:hover,.user-btn:hover{border-color:var(--accent);}
.grid{display:grid;grid-template-columns:1fr;gap:14px;}
@media(min-width:760px){.grid{grid-template-columns:1fr 1fr;}}
.panel{background:linear-gradient(180deg, var(--panel), var(--panel2));border:1px solid var(--line); border-radius:var(--radius);padding:14px; display:flex; flex-direction:column; gap:10px;box-shadow:0 8px 24px rgba(0,0,0,.18);}
.panel-head{display:flex;justify-content:space-between;align-items:center;gap:8px;}
.panel-head label{font-size:.74rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-weight:700;}
textarea{width:100%; min-height:250px; resize:vertical;background:var(--bg2); color:var(--text); border:1px solid var(--line);border-radius:10px; padding:10px; font-family:var(--mono); font-size:.82rem;line-height:1.45; outline:none;}
textarea:focus{border-color:var(--accent);}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
.opt{display:flex;align-items:center;gap:6px;font-size:.74rem;color:var(--muted);}
select,input[type=text],input[type=password]{background:var(--bg2);color:var(--text);border:1px solid var(--line);border-radius:7px;padding:5px 8px;font-family:var(--mono);font-size:.76rem;}
button{font-family:var(--mono); font-size:.82rem; font-weight:700;border-radius:9px; border:1px solid var(--accent-dim); cursor:pointer;padding:10px 16px; background:transparent; color:var(--text);transition:filter .15s, transform .1s;}
button:active{transform:scale(.97);}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#04120a;border:none;}
.btn-primary:hover{filter:brightness(1.08);}
.btn-ghost:hover{background:var(--accent-dim);}
.file-btn{position:relative;overflow:hidden;}
.file-btn input[type=file]{position:absolute;inset:0;opacity:0;cursor:pointer;}
.stat{font-size:.7rem;color:var(--muted);}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--accent);color:#04120a;padding:8px 16px;border-radius:20px;font-size:.78rem;font-weight:700;opacity:0;pointer-events:none;transition:opacity .25s;z-index:10;}
.toast.show{opacity:1;}
.tagline{color:var(--muted);font-size:.8rem;margin:0 0 16px;}
/* auth overlay */
#authGate{position:fixed;inset:0;background:var(--bg);z-index:50;display:flex;align-items:center;justify-content:center;padding:20px;}
#authGate.hidden{display:none;}
.authBox{width:100%;max-width:340px;background:linear-gradient(180deg,var(--panel),var(--panel2));border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:0 8px 24px rgba(0,0,0,.25);}
.authBox h2{margin:0 0 4px;font-size:1rem;}
.authBox p{margin:0 0 14px;color:var(--muted);font-size:.75rem;}
.authBox input{width:100%;margin-bottom:8px;padding:9px 10px;font-size:.85rem;}
.authBox .row{margin-top:6px;justify-content:space-between;}
.authErr{color:#ff6b6b;font-size:.72rem;min-height:1em;margin:0 0 6px;}
#wrap.locked{filter:blur(6px);pointer-events:none;user-select:none;}

/* ===== NEW MAIN UI ===== */
:root{--bg:#050608;--bg2:#090d13;--panel:#0d1118;--panel2:#080b10;--line:#1d2734;--text:#f5f7fb;--muted:#7f8b9b;--accent:#7c5cff;--accent-2:#00d9ff;--accent-dim:rgba(124,92,255,.18);--radius:20px}
body{background:radial-gradient(900px 520px at 0 -10%,rgba(124,92,255,.20),transparent 62%),radial-gradient(850px 520px at 105% 0,rgba(0,217,255,.14),transparent 60%),linear-gradient(145deg,#030406,#090d13 55%,#05070a);font-family:var(--mono)}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.22;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,#000,transparent 90%)}
.wrap{max-width:1180px;padding:18px 18px 55px}
.topbar{position:relative;padding:16px 18px;margin-bottom:14px;border:1px solid rgba(255,255,255,.08);border-radius:24px;background:rgba(10,13,18,.72);backdrop-filter:blur(22px);box-shadow:0 20px 60px rgba(0,0,0,.35),inset 0 1px rgba(255,255,255,.05)}
.brand{gap:13px}.brand .dot{width:13px;height:13px;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 0 20px var(--accent),0 0 38px rgba(0,217,255,.3)}.brand h1{font-size:1.15rem;font-weight:900}.brand .owner{margin-top:4px}
.icon-btn,.lang-btn,.user-btn,input[type=color]{height:38px;border:1px solid #263242;border-radius:11px;background:#0a0e14;color:var(--text);transition:.18s}.icon-btn{width:38px}.icon-btn:hover,.lang-btn:hover,.user-btn:hover{border-color:var(--accent);box-shadow:0 0 18px rgba(124,92,255,.18);transform:translateY(-1px)}
